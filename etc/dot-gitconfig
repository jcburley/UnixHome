[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	visual = !gitk
	skip = update-index --skip-worktree
	unskip = update-index --no-skip-worktree
	sweep = "!git fetch -p && for b in $(git for-each-ref --format='%(refname:short) %(upstream)' refs/heads/ | awk '$1 != \"main\" && $2 == \"\" {print $1}'); do git branch -d \"$b\"; done"
	purge = "!git fetch -p && for b in $(git for-each-ref --format='%(refname:short) %(upstream)' refs/heads/ | awk '$1 != \"main\" && $2 == \"\" {print $1}'); do git branch -D \"$b\"; done"
